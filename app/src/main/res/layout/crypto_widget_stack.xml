<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/cell_bg"
        android:padding="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RENDER" android:textColor="#F2F2F0" android:textStyle="bold" android:textSize="11sp" />
            <TextView android:id="@+id/price_render" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#F2F2F0" android:textSize="11sp" />
            <TextView android:id="@+id/chg_render" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/spark_render" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/cell_bg"
        android:padding="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ATOM" android:textColor="#F2F2F0" android:textStyle="bold" android:textSize="11sp" />
            <TextView android:id="@+id/price_atom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#F2F2F0" android:textSize="11sp" />
            <TextView android:id="@+id/chg_atom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/spark_atom" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:scaleType="fitXY" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/cell_bg"
        android:padding="6dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CKB" android:textColor="#F2F2F0" android:textStyle="bold" android:textSize="11sp" />
            <TextView android:id="@+id/price_ckb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#F2F2F0" android:textSize="11sp" />
            <TextView android:id="@+id/chg_ckb" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textSize="10sp" />
        </LinearLayout>
        <ImageView android:id="@+id/spark_ckb" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:scaleType="fitXY" />
    </LinearLayout>
</LinearLayout>
